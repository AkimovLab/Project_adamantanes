#Generated by Multiwfn
&GLOBAL
  PROJECT AMS
  PRINT_LEVEL Medium
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  
  METHOD  QS
#  &PROPERTIES
#    &TDDFPT
#       NSTATES     10             # number of excited states
#       MAX_ITER    200           # maximum number of Davidson iterations
#       CONVERGENCE [eV] 1.0e-5   # convergence on maximum energy change between iterations
#       &MGRID
#          NGRIDS 25
#          CUTOFF 100
#       &END
#
#       !RESTART     .TRUE.
#       !WFN_RESTART_FILE_NAME RESTART.tdwfn
#
#    &END TDDFPT
#  &END PROPERTIES
  &SUBSYS
    &TOPOLOGY
      COORD_FILE_NAME traj.xyz 
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES T
      &END
    &END
    &CELL
      A    20.79414200     0.00000000     0.00000000
      B     0.00000000    20.79414200     0.00000000
      C     0.00000000     0.00000000    20.79414200
      PERIODIC NONE #Direction(s) of applied PBC (geometry aspect)
    &END CELL
#    &COORD
#      C           2.06580000    3.49536000    5.28511900
#      C           1.85658000    2.25720000    4.39707100
#      C           3.30000000    3.30000000    6.17228600
#      C           3.49536000    4.53420000    3.52488100
#      C           2.25720000    4.74342000    4.41292900
#      C           3.30000000    3.30000000    2.63771400
#      C           4.53420000    3.10464000    5.28511900
#      C           4.74342000    4.34280000    4.39707100
#      C           3.10464000    2.06580000    3.52488100
#      C           4.34280000    1.85658000    4.41292900
#      H           2.94360000    1.20780000    2.96016000
#      H           4.23060000    3.18780000    2.05273000
#      H           5.21400000    1.73580000    3.78830000
#      H           4.15140000    0.96360000    4.96884000
#      H           5.39220000    2.94360000    5.84984000
#      H           3.41220000    4.23060000    6.75727000
#      H           4.86420000    5.21400000    5.02170000
#      H           5.63640000    4.15140000    3.84116000
#      H           3.65640000    5.39220000    2.96016000
#      H           2.36940000    3.41220000    2.05273000
#      H           1.38600000    4.86420000    3.78830000
#      H           2.44860000    5.63640000    4.96884000
#      H           1.20780000    3.65640000    5.84984000
#      H           3.18780000    2.36940000    6.75727000
#      H           1.73580000    1.38600000    5.02170000
#      H           0.96360000    2.44860000    3.84116000
#    &END COORD
#   &VELOCITY #You can set initial atomic velocities in this section
#   &END VELOCITY
    &KIND C
      ELEMENT C
      BASIS_SET 6-311++G**
      POTENTIAL ALL
    &END KIND
    &KIND H
      ELEMENT H
      BASIS_SET 6-311++G**
      POTENTIAL ALL
    &END KIND
  &END SUBSYS

  &DFT
    BASIS_SET_FILE_NAME  EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME  ALL_POTENTIALS
#   WFN_RESTART_FILE_NAME AMS-RESTART.wfn
    CHARGE    0 #Net charge
    MULTIPLICITY    1 #Spin multiplicity
    &QS
      EPS_DEFAULT 1.0E-10 #Set all EPS_xxx to values such that the energy will be correct up to this value
      EPS_PGF_ORB 1E-12 #If warning "Kohn Sham matrix not 100% occupied" occurs and meantime calculation is unstable, decrease it
      EXTRAPOLATION ASPC #Extrapolation for wavefunction during e.g. MD. ASPC is default, PS can also be used
      EXTRAPOLATION_ORDER 3 #Order for PS or ASPC extrapolation. 3 is default
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE #Direction(s) of PBC for calculating electrostatics
      PSOLVER WAVELET #The way to solve Poisson equation
    &END POISSON
    &XC
      &XC_FUNCTIONAL
        &LYP
          SCALE_C 0.81
        &END
        &BECKE88
          SCALE_X 0.72
        &END
        &VWN
          FUNCTIONAL_TYPE VWN3 #Gaussian's B3LYP definition
          SCALE_C 0.19
        &END
        &XALPHA
          SCALE_X 0.08
        &END
      &END XC_FUNCTIONAL
      &HF
        FRACTION 0.2 #HF composition
        &SCREENING
          EPS_SCHWARZ 1E-6 #The larger the value, the lower the cost and lower the accuracy
          SCREEN_ON_INITIAL_P F #Screening ERI based on initial density matrix, need to provide wavefunction restart file
        &END SCREENING
        &MEMORY
          MAX_MEMORY 3000 #Memory(MB) per MPI process for calculating HF exchange
          EPS_STORAGE_SCALING 0.1
        &END MEMORY
      &END HF
    &END XC
    &MGRID
      CUTOFF  350
      REL_CUTOFF  50
    &END MGRID
    &SCF
      MAX_SCF 128
      EPS_SCF 1.0E-05 #Convergence threshold of density matrix of inner SCF
#     SCF_GUESS RESTART #Use wavefunction from WFN_RESTART_FILE_NAME file as initial guess
      &DIAGONALIZATION
        ALGORITHM STANDARD #Algorithm for diagonalization. DAVIDSON is faster for large systems
      &END DIAGONALIZATION
      &MIXING #How to mix old and new density matrices
        METHOD BROYDEN_MIXING #PULAY_MIXING is also a good alternative
        ALPHA 0.4 #Default. Mixing 40% of new density matrix with the old one
        NBROYDEN 8 #Default is 4. Number of previous steps stored for the actual mixing scheme
      &END MIXING
      ADDED_MOS    250 #Number of virtual MOs to solve

      &PRINT
        &RESTART OFF #Do not generate wfn file to suppress meaningless I/O cost
        &END RESTART
      &END PRINT
    &END SCF
    &PRINT
    &MULLIKEN OFF   
      &END
      &HIRSHFELD OFF
      &END
      &MO ON
        FILENAME adamantane
        EIGENVECTORS F
        EIGENVALUES F
        NDIGITS 8
      &END
      &PDOS
        APPEND T
        COMPONENTS T
        FILENAME adamantane
      &END
      &MO_MOLDEN ON
        FILENAME
        NDIGITS 8
        GTO_KIND SPHERICAL
      &END
      &MO_CUBES
        NHOMO 1
        NLUMO 1
        STRIDE 3 3 3
        WRITE_CUBE T
      &END
    &END PRINT
  &END DFT
  &PROPERTIES
      &TDDFPT #TDDFT calculation with Tamm-Dancoff approximation
        NSTATES   30 #Number of excited states to solve
        RKS_TRIPLETS F #If calculating triplet rather than singlet excited states
        CONVERGENCE [eV] 1E-4 #Convergence criterion of all excitation energies
        MIN_AMPLITUDE 0.01 #The smallest excitation amplitude to print
        &PRINT
          &DETAILED_ENERGY #Print excitation energies at every Davidson iteration
          &END DETAILED_ENERGY
        &END PRINT
      &END TDDFPT
  &END PROPERTIES
  #
&END FORCE_EVAL

