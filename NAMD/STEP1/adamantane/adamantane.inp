#   &VELOCITY #You can set initial atomic velocities in this section
#   &END VELOCITY
    &KIND C
      ELEMENT C
      BASIS_SET 6-311Gxx
      POTENTIAL ALL
    &END KIND
    &KIND H
      ELEMENT H
      BASIS_SET 6-311Gxx
      POTENTIAL ALL
    &END KIND
  &END SUBSYS

  &DFT
    BASIS_SET_FILE_NAME  EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME  ALL_POTENTIALS
#   WFN_RESTART_FILE_NAME AMS-RESTART.wfn
    CHARGE    0 #Net charge
    MULTIPLICITY    1 #Spin multiplicity
    #&EXCITED_STATES
    #  STATE  -1
   # &END EXCITED_STATES
    &QS
      EPS_DEFAULT 1.0E-10 #Set all EPS_xxx to values such that the energy will be correct up to this value
      EPS_PGF_ORB 1E-12 #If warning "Kohn Sham matrix not 100% occupied" occurs and meantime calculation is unstable, decrease it
      EXTRAPOLATION ASPC #Extrapolation for wavefunction during e.g. MD. ASPC is default, PS can also be used
      EXTRAPOLATION_ORDER 3 #Order for PS or ASPC extrapolation. 3 is default
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE #Direction(s) of PBC for calculating electrostatics
      PSOLVER WAVELET #The way to solve Poisson equation
    &END POISSON
    &XC
     # &XC_FUNCTIONAL
     #   &BEEF .TRUE.
     #   &END
     # &END
      &XC_FUNCTIONAL B3LYP
      &END XC_FUNCTIONAL
    &END XC
   # &XC
   #   &XC_FUNCTIONAL
   #           &HYB_GGA_XC_CAM_B3LYP
   #           &END HYB_GGA_XC_CAM_B3LYP
   #   &END XC_FUNCTIONAL
   #   &HF
   #     FRACTION 1.0 #HF composition
   #     &SCREENING
   #       EPS_SCHWARZ 1E-6 #The larger the value, the lower the cost and lower the accuracy
   #       SCREEN_ON_INITIAL_P F #Screening ERI based on initial density matrix, need to provide wavefunction restart file
   #     &END SCREENING
